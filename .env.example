# ---------------------------------------------------------------------------
# MAAR AI — environment configuration
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and NEVER committed.
# ---------------------------------------------------------------------------

# NVIDIA NIM API key (from https://build.nvidia.com).
# Used ONLY on the server, inside src/app/api/chat/route.ts.
# It is never sent to the browser and never prefixed with NEXT_PUBLIC_.
NVIDIA_API_KEY=nvapi-your-key-here

# Base URL for NVIDIA's OpenAI-compatible NIM endpoint. Override only if
# you are pointing at a self-hosted NIM or a different region.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------------------------------------------------------------------------
# OpenRouter (optional second provider) — https://openrouter.ai/keys
# Used ONLY on the server, inside src/lib/ai/providers/openrouter.ts.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the OpenRouter base URL (rarely needed).
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# Optional: shown to OpenRouter for usage attribution / rate limiting on
# some free models. Set to your real deployed URL once you have one.
OPENROUTER_SITE_URL=https://maar-ai.vercel.app
