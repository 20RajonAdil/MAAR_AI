# ---------------------------------------------------------------------------
# MAAR AI — environment configuration
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and NEVER committed.
# ---------------------------------------------------------------------------

# NVIDIA NIM API key (from https://build.nvidia.com).
# Used ONLY on the server, inside src/app/api/chat/route.ts.
# It is never sent to the browser and never prefixed with NEXT_PUBLIC_.
NVIDIA_API_KEY=nvapi-your-key-here

# Base URL for NVIDIA's OpenAI-compatible NIM endpoint. Override only if
# you are pointing at a self-hosted NIM or a different region.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
